[Unit]
Description=FB Monitor - Facebook Group Keyword Tracker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/fb-monitor
Environment="PATH=/opt/fb-monitor/venv/bin"
ExecStart=/opt/fb-monitor/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fb-monitor

[Install]
WantedBy=multi-user.target
